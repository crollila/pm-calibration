# Copy to .env and fill in. Only The Odds API needs a key; Polymarket and Kalshi
# market data are public.
ODDS_API_KEY=

# Comma-separated sport keys for The Odds API (each sport costs 1 credit/request).
PMCAL_SPORTS=americanfootball_nfl,basketball_nba,baseball_mlb

# Where the DuckDB file lives.
PMCAL_DB=data/pm_calibration.duckdb

# Polymarket taker fee rate used by the backtest cost model (fraction, not bps).
# Category-tiered in practice, roughly 0.0075 - 0.0180.
PMCAL_POLY_FEE=0.0100
